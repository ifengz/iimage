{
  "name": "iimage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bash scripts/dev-all.sh",
    "dev:web": "vite",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "ocr:server": ".venv-ocr/bin/python -m uvicorn ocr_server.app:app --host 127.0.0.1 --port 8787",
    "ocr:check": "python3 -m py_compile ocr_server/app.py"
  },
  "dependencies": {
    "newapi-media-client": "file:vendor/newapi-media-client-0.1.0.tgz",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.5.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
