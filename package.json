{
  "name": "gemini-batch-editor-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "ocr:server": ".venv-ocr/bin/python -m uvicorn ocr_server.app:app --host 127.0.0.1 --port 8787",
    "ocr:check": "python3 -m py_compile ocr_server/app.py"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.5.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
